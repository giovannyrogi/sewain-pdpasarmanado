-- **Dengan trigger ini, setiap kali Anda insert/update ke tenant_application, database akan menolak jika room_id tidak sesuai dengan location_id yang dipilih.**
CREATE OR REPLACE FUNCTION validate_room_location()
RETURNS TRIGGER AS $$
DECLARE
    room_loc_id INTEGER;
BEGIN
    SELECT location_id INTO room_loc_id FROM rooms WHERE id = NEW.room_id;
    IF room_loc_id IS NULL THEN
        RAISE EXCEPTION 'Room ID % tidak ditemukan', NEW.room_id;
    END IF;
    IF room_loc_id <> NEW.location_id THEN
        RAISE EXCEPTION 'Room ID % tidak terdaftar pada Location ID %', NEW.room_id, NEW.location_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_validate_room_location
BEFORE INSERT OR UPDATE ON tenant_application
FOR EACH ROW EXECUTE FUNCTION validate_room_location();

-- CEK DAFTAR TRIGGER SAAT INI
SELECT
    event_object_table AS table_name,
    trigger_name,
    action_timing AS trigger_timing,
    event_manipulation AS event,
    action_statement AS function_called,
    action_orientation AS orientation
FROM
    information_schema.triggers
ORDER BY