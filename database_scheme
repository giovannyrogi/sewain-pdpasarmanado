-------------- TABEL MASTER DATA -----------------
-- Tabel lokasi pasar/gedung
CREATE TABLE locations (
    id SERIAL PRIMARY KEY,
    location_name VARCHAR(100) NOT NULL,
    street_address TEXT,
    location_code VARCHAR(50),
    kelurahan VARCHAR(100),                 -- Kelurahan / Desa
    district VARCHAR(100),                  -- Kecamatan
    city VARCHAR(100),                      -- Kota/Kabupaten
    province VARCHAR(100),                  -- Provinsi
    postal_code VARCHAR(10),                -- Kode pos
    longtitude VARCHAR(50),
    latitude VARCHAR(50),
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Harga dasar per lantai di tiap lokasi
CREATE TABLE location_floor_prices (
    id SERIAL PRIMARY KEY,
    location_id INTEGER REFERENCES locations(id),
    floor VARCHAR(10), -- misal "1", "2", "LG", "UG"
    base_price NUMERIC(18,2) NOT NULL, -- harga sewa dasar per lantai (misal /bulan)
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel ruangan
CREATE TABLE rooms (
    id SERIAL PRIMARY KEY,
    location_id INTEGER REFERENCES locations(id),
    room_number VARCHAR(20) NOT NULL,
    floor_id INTEGER REFERENCES location_floor_prices(id),
    room_length NUMERIC(8,2),
	room_width NUMERIC(8,2),	
	room_area NUMERIC(18,2) GENERATED ALWAYS AS (room_length * room_width) stored,
	price_per_m2 NUMERIC(18,2) NOT NULL DEFAULT 0,
    status VARCHAR(20) CHECK (status IN ('available','occupied','unavailable', 'maintenance')) DEFAULT 'available',
    occupied_by INTEGER REFERENCES tenant_application(id),
    notes TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel role user
CREATE TABLE roles (
    id SERIAL PRIMARY KEY,
    role_name VARCHAR(50) NOT NULL UNIQUE,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel user
CREATE TABLE users (
    id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    username VARCHAR(100) NOT NULL,
    password TEXT NOT NULL,
    email VARCHAR(100) UNIQUE,
    role_id INTEGER REFERENCES roles(id),
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel identitas tenant (versi lebih detail untuk alamat dengan kelurahan & lingkungan dipisah)
CREATE TABLE tenant_identities (
    id SERIAL PRIMARY KEY,
    user_id INTEGER REFERENCES users(id),   -- opsional: hubungkan ke users
    nik VARCHAR(20) UNIQUE NOT NULL,        -- nomor KTP
    full_name VARCHAR(100) NOT NULL,
    ktp_file_path TEXT NOT NULL,            -- Path/URL file KTP penyewa
    birth_place VARCHAR(50),
    birth_date DATE,
    nationality VARCHAR(50),
    religion VARCHAR(50),
    occupation VARCHAR(100),
    -- Alamat detail
    street_address TEXT,                    -- nama jalan & nomor rumah
    rt VARCHAR(3),                          -- RT
    rw VARCHAR(3),                          -- RW
    kelurahan VARCHAR(100),                 -- Kelurahan / Desa
    district VARCHAR(100),                  -- Kecamatan
    city VARCHAR(100),                      -- Kota/Kabupaten
    province VARCHAR(100),                  -- Provinsi
    postal_code VARCHAR(10),                -- Kode pos
    phone VARCHAR(20),
    status VARCHAR(20) CHECK (status IN ('active', 'inactive', 'blacklisted')) DEFAULT 'active';
   	notes TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-------------- TABEL TRANSAKSI DAN APPROVAL -----------------
-- Tabel permohonan sewa (tenant application)
CREATE TABLE tenant_application (
    id SERIAL PRIMARY KEY, -- Primary key, auto increment
    renewal_of INTEGER REFERENCES tenant_application(id) ON DELETE CASCADE,
    user_id INTEGER REFERENCES users(id), -- User yang membuat permohonan sewa
    tenant_identity_id INTEGER REFERENCES tenant_identities(id), -- identitas penyewa
    document_number VARCHAR(50), -- ditambahkan untuk nomor dokumen
    location_id INTEGER REFERENCES locations(id), -- Lokasi pasar/gedung
    room_id INTEGER REFERENCES rooms(id), -- Ruangan yang disewa
    start_date DATE, -- Tanggal mulai kontrak
    end_date DATE, -- Tanggal akhir kontrak
    payment_type VARCHAR(20) CHECK (payment_type IN ('lunas', 'cicilan')), -- Jenis pembayaran (lunas/cicilan)
    total_payment_room NUMERIC(18,2), -- Total biaya sewa kontrak ruangan
    admin_fee NUMERIC(18,2), -- biaya administrasi
    total_ppn NUMERIC(18,2), -- total ppn 11%
    total_payment NUMERIC(18,2) NOT NULL, -- Total pembayaran kontrak
    down_payment NUMERIC(18,2), -- Uang muka (DP), jika cicilan
    remaining_payment NUMERIC(18,2), -- Sisa pembayaran (jika cicilan)
    estimated_installment_1 NUMERIC(18,2), -- Estimasi cicilan 1
   	estimated_installment_1_date DATE, -- Estimasi tanggal pembayaran cicilan 1
    estimated_installment_2 NUMERIC(18,2), -- Estimasi cicilan 2
    estimated_installment_2_date DATE, -- Estimasi tanggal pembayaran cicilan 2
    estimated_installment_3 NUMERIC(18,2), -- Estimasi cicilan 3
    estimated_installment_3_date DATE, -- Estimasi tanggal pembayaran cicilan 3
    approval_status VARCHAR(20) DEFAULT 'proses', -- Status approval permohonan
    current_step INTEGER DEFAULT 1, -- Approval sedang di step ke berapa
    current_payment_step INTEGER DEFAULT 1, -- cicilan terakhir dibayar
    is_fully_paid BOOLEAN DEFAULT FALSE,   -- status lunas dari table payments
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP, -- Waktu terakhir update data
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Waktu pembuatan data
);

-- Tabel approval/paraf berurutan (tenant approval)
CREATE TABLE tenant_approval (
    id SERIAL PRIMARY KEY,
    tenant_application_id INTEGER REFERENCES tenant_application(id),
    approver_id INTEGER REFERENCES users(id),
    role_id INTEGER REFERENCES roles(id),
    step_order INTEGER, -- urutan approval
    approved_at TIMESTAMP,
    status VARCHAR(20) CHECK (status IN ('pending', 'approved', 'rejected')) DEFAULT 'pending',
    notes TEXT,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel untuk menyimpan data tenant yang akan dinon-aktifkan
CREATE TABLE tenant_early_terminations (
    id SERIAL PRIMARY KEY,
    tenant_application_id INTEGER NOT NULL REFERENCES tenant_application(id) ON DELETE CASCADE,
    reason TEXT NOT NULL,
    statement_file_path TEXT NOT NULL,
    processed_by INTEGER REFERENCES users(id),
    terminated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    current_step INTEGER DEFAULT 1,
    approval_status VARCHAR(20) CHECK (approval_status IN ('proses', 'approved', 'rejected')) DEFAULT 'proses', 
    is_terminated BOOLEAN DEFAULT FALSE,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- Tabel approval untuk proses non-aktif data tenant
CREATE TABLE tenant_termination_approval (
    id SERIAL PRIMARY KEY,
    tenant_early_termination_id INTEGER NOT NULL REFERENCES tenant_early_terminations(id) ON DELETE CASCADE,
    role_id INTEGER NOT NULL REFERENCES roles(id),
    step_order INTEGER NOT NULL,
    status VARCHAR(20) CHECK (status IN ('pending', 'approved', 'rejected')) DEFAULT 'pending',
    approver_id INTEGER REFERENCES users(id),
    notes TEXT,
    approved_at TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-- Tabel pembayaran (termasuk cicilan)
CREATE TABLE payments (
    id SERIAL PRIMARY KEY,
    tenant_application_id INTEGER NOT NULL REFERENCES tenant_application(id) ON DELETE CASCADE,
    payment_number INTEGER CHECK (payment_number BETWEEN 1 AND 4) DEFAULT 1, -- Cicilan ke-1/2/3/4 RIC(18,2) NOT NULL, -- Nominal pembayaran
    amount NUMERIC(18,2) DEFAULT 0,
    contract_amount NUMERIC(18,2) DEFAULT 0,
    ppn_amount NUMERIC(18,2) DEFAULT 0, -- Total PPN
    remaining_balance NUMERIC(18,2) DEFAULT 0, -- Nominal sisa yang harus dibayar
    payment_date DATE NOT NULL, -- Tanggal pembayaran yang dilakukan penyewa
    proof_file_path TEXT NOT NULL, -- Bukti pembayaran (upload admin kontrak dari penyewa)
    uploaded_by INTEGER NOT NULL REFERENCES users(id), -- siapa yang upload bukti pembayaran (admin kontrak)
    approval_status VARCHAR(20) CHECK (approval_status IN ('proses','approved','rejected')) DEFAULT 'pending', 
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);



-- Tabel approval pembayaran
CREATE TABLE payment_approval (
    id SERIAL PRIMARY KEY,
    payment_id INTEGER NOT NULL REFERENCES payments(id) ON DELETE CASCADE,
    role_id INTEGER NOT NULL REFERENCES roles(id),  -- role yang harus approve
    step_order INTEGER NOT NULL,                    -- urutan approval
    status VARCHAR(20) CHECK (status IN ('pending','approved','rejected')) DEFAULT 'pending',
    approver_id INTEGER REFERENCES users(id),       -- user yang approve (keuangan)
    notes TEXT,
    proof_verified_file_path TEXT,                  -- bukti validasi keuangan jika ada
    approved_at TIMESTAMP,                          -- waktu approve/reject
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);



-- Tabel dokumen (KTP, bukti bayar, dsb)
CREATE TABLE documents (
    id SERIAL PRIMARY KEY,
    tenant_application_id INTEGER REFERENCES tenant_application(id),
    user_id INTEGER REFERENCES users(id),
    doc_type VARCHAR(50), -- 'ktp', 'bukti_bayar', etc
    file_path TEXT NOT NULL,
    uploaded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabel kontrak (buku kontrak yang sudah jadi)
CREATE TABLE contracts (
    id SERIAL PRIMARY KEY,
    tenant_application_id INTEGER REFERENCES tenant_application(id),
    contract_number VARCHAR(50) UNIQUE,
    contract_file_path TEXT,
    contract_date DATE,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);


-------------- Trigger & Function untuk updated_at -----------------
-- Function untuk auto-update kolom updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Tambahkan trigger ke setiap tabel yang ada kolom updated_at
CREATE TRIGGER trigger_locations_updated_at
BEFORE UPDATE ON locations
FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

